function [dataset,labelset,name,generation,Rep,JLInterval] = Inputdata_1(s)
%INPUTDATA 此处显示有关此函数的摘要
%   此处显示详细说明
    filepath = 'C:\Users\小黑\Desktop\王宁师兄\舒生达师兄论文\舒生达-工作资料\舒生达-工作资料\';
    Rep = 5;
   switch s
        case 12
            name = 'Dexter';
