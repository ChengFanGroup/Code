        case 20
        name='australian';
        %导入australian数据集
        [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,labelset] =textread('C:\Users\小黑\Desktop\王宁师兄\舒生达师兄论文\舒生达-工作资料\舒生达-工作资料\dataset\australian.txt','%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f');
        labelset=labelset';
        dataset=[A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14];
        dataset=dataset';
        generation = 800;
        Rep = 30;
        JLInterval = 10;

        case 21
        load('C:\Users\小黑\Desktop\王宁师兄\舒生达师兄论文\舒生达-工作资料\舒生达-工作资料\dataset\ecoli3.mat');%%%导入数据集
        dataset = A(:,1:end-1)' ;%instance          %%行为特征数7，列为数据量336
        labelset =  A(:,end)';%label
        name='ecoli3';
        generation = 800;
        Rep = 30;
        JLInterval = 10;

         case 22
        name='sonarall';
        %导入sonarall的数据集,R设为0，M设为1
        % function [dataset,whether]=inputdataset()
        [A1,A2,A3,A4,A5,A6,A7,A8,A9,A10,A11,A12,A13,A14,A15,A16,A17,A18,A19,A20,A21,A22,A23,A24,A25,A26,A27,A28,A29,A30,A31,A32,A33,A34,A35,A36,A37,A38,A39,A40,A41,A42,A43,A44,A45,A46,A47,A48,A49,A50,A51,A52,A53,A54,A55,A56,A57,A58,A59,A60,whethertemp] =textread('C:\Users\小黑\Desktop\王宁师兄\舒生达师兄论文\舒生达-工作资料\舒生达-工作资料\dataset\sonarall.txt','%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%f%s','delimiter', ',');
        whethertemp=whethertemp';
        % whether=str2num(char(whethertemp));
        % a=size(whethertemp);

        labelset=zeros(1,size(whethertemp,2));
        for i=1:size(whethertemp,2)
